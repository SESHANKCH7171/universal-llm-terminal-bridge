# ==========================================================
# Claude Code Proxy Configuration (.env.example)
# Copy this file to .env and configure your credentials.
# ==========================================================

# 1. Routing Mode
# Set to 'true' to route requests to Google Cloud Vertex AI (using service account credentials).
# Set to 'false' to route directly to Google AI Studio (using GEMINI_API_KEY).
USE_VERTEX_AUTH=true

# 2. Google Cloud Vertex AI Settings (when USE_VERTEX_AUTH=true)
VERTEX_PROJECT=your-google-cloud-project-id
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=google-creds.json

# (Alternative) Google AI Studio Key (when USE_VERTEX_AUTH=false)
# GEMINI_API_KEY=your-google-ai-studio-api-key

# 3. Model Mappings
# Maps Claude Code models (Opus, Sonnet, Haiku) to Gemini models:
OPUS_MODEL=gemini/gemini-2.5-pro
SONNET_MODEL=gemini/gemini-2.5-pro
HAIKU_MODEL=gemini/gemini-2.5-flash

# 4. Server Settings
PORT=8082
HOST=127.0.0.1

# 5. Optional Other Backends
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
